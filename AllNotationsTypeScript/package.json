{
    "name": "all-notations-typescript-starter",
    "version": "1.0.0",
    "description": "A demo of ClasHStamP for generating TypeScript code with absolute import paths.",
    "main": "index.js",
    "scripts": {
        "dev": "tsc-watch --onSuccess \"node dist/main.js\"",
        "build": "tsc",
        "start": "node dist/main.js"
    },
    "_moduleAliases": {
        "@server": "dist/server",
        "@common": "dist/common",
        "@all_notations": "dist/all_notations"
    },
    "repository": {
        "type": "git",
        "url": "git+github.com:ducyen/ClasHStamP_EMF.git"
    },
    "author": "Duc Hoang",
    "homepage": "https://ducyen.github.io/ClasHStamP/",
    "devDependencies": {
        "tsc-watch": "^4.2.8",
        "typescript": "^3.9.5"
    },
    "dependencies": {
        "module-alias": "^2.2.2",
        "source-map-support": "^0.5.19"
    }
}
